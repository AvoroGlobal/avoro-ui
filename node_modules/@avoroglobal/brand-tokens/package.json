{
  "name": "@avoroglobal/brand-tokens",
  "version": "1.6.0",
  "description": "Avoro brand design tokens for Tailwind, CSS variables, and TypeScript consumers.",
  "type": "module",
  "sideEffects": [
    "./dist/css-variables.css"
  ],
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CLAUDE.md"
  ],
  "bin": {
    "avoro-lint": "./scripts/avoro-lint.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./css": "./dist/css-variables.css",
    "./w3c": "./dist/tokens.w3c.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvoroGlobal/avoro-brand-tokens.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-w3c.mjs",
    "lint:self": "node scripts/avoro-lint.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED"
}
